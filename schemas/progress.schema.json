{
  "type": "object",
  "properties": {
    "schema_version": {"const": "0.2"},
    "course_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "updated_at": {"anyOf": [{"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, {"type": "null"}]},
    "current_lesson_id": {"anyOf": [{"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"}, {"type": "null"}]},
    "lesson_status": {"type": "array", "items": {"type": "object", "properties": {"lesson_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"}, "status": {"enum": ["not_started", "in_progress", "needs_review", "passed", "skipped"]}, "assistance": {"enum": ["independent", "assisted", "self_reported", "not_assessed"]}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "minItems": 0}, "notes": {"type": "string"}}, "required": ["lesson_id", "status", "assistance", "evidence"], "additionalProperties": false, "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"evidence": {"minItems": 1}, "assistance": {"not": {"const": "not_assessed"}}}}}]}, "minItems": 0},
    "next_action": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "required": ["schema_version", "course_id", "updated_at", "current_lesson_id", "lesson_status", "next_action"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learn Any Skill progress checkpoint v0.2"
}
